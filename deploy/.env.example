# `bash install.sh` fills empty secret values and never overwrites an existing
# value in deploy/.env. Keep this file as the documented template.
POSTGRES_PASSWORD=
NOOK_OWNER_EMAIL=owner@localhost
NOOK_OWNER_PASSWORD=
NOOK_COLLAB_JWT_SECRET=
NOOK_INTERNAL_TOKEN=

# Optional release selector. The CI publishes `latest` for the main branch.
# Pin this to a commit tag (for example, `sha-0123456789ab`) to roll back or
# deploy a specific build.
NOOK_IMAGE_TAG=latest

# Optional host port for the web container. Defaults to 80.
# NOOK_HTTP_PORT=80

# For private GHCR packages, export GHCR_USERNAME and GHCR_TOKEN before
# running install.sh. They are not stored in this file.
