{$NOOK_DOMAIN} {
	encode zstd gzip

	# Collaboration WebSocket → Hocuspocus (strip /collab prefix)
	handle_path /collab* {
		reverse_proxy collab:1234
	}

	# Internal endpoints must never be reachable from outside
	handle /internal* {
		respond 404
	}

	# API, SignalR hub, OpenAPI, Hangfire dashboard and the SPA itself
	handle {
		reverse_proxy api:5100
	}
}
