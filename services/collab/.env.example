# Copy of the collab-relevant variables from the repo-root .env.example.
# In development the service reads ../../.env automatically; these are only needed when running it standalone.
COLLAB_PORT=1234
COLLAB_INTERNAL_PORT=1235
COLLAB_API_BASE=http://localhost:5000
NOOK_INTERNAL_TOKEN=dev-internal-token-change-me
NOOK_COLLAB_JWT_SECRET=dev-collab-secret-change-me
LOG_LEVEL=info
LOG_PRETTY=1
